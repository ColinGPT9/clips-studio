   "description": "An unofficial, independently developed GTA-style highlight pipeline. Finds explicit chase, crash, stunt, combat and reaction cues, plus source-grounded dialogue suggestions from the existing local model. Uses the host transcript, measured picture and sound changes and permitted viewer nominations. It does not recognize vehicles or police from pixels and has not been validated on GTA VI gameplay. Rendering stays in Clips Kitty.\n",
   "events": [
    "chase",
    "crash",
    "stunt",
    "combat",
    "npc_chaos",
    "funny_dialogue",
    "roleplay",
    "reaction",
    "milestone",
    "viewer_nominated"
   ],
   "execution": "local",
   "games": [
    "grand-theft-auto-vi",
    "grand-theft-auto-v"
   ],

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clips Kitty plugin manifest (clipskitty.yaml)",
  "description": "Generated by clipskitty_sdk.manifest.json_schema(); python -m clipskitty_sdk validate checks more than this schema can.",
  "type": "object",
  "required": [
    "manifest_version",
    "id",
    "name",
    "version",
    "kind",
    "capability",
    "description",
    "license",
    "requires",
    "run",
    "execution",
    "inputs",
    "outputs",
    "permissions"
  ],
  "properties": {
    "manifest_version": {
      "enum": [
        1
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,38}/[a-z0-9][a-z0-9-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "kind": {
      "enum": [
        "pipeline"
      ]
    },
    "capability": {
      "enum": [
        "highlight_detection"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        }
      }
    },
    "repository": {
      "type": "string",
      "pattern": "^https://"
    },
    "license": {
      "type": "string",
      "pattern": "^[A-Za-z0-9.+-]+( (AND|OR|WITH) [A-Za-z0-9.+-]+)*$"
    },
    "requires": {
      "type": "object",
      "required": [
        "clips_kitty",
        "plugin_api"
      ],
      "properties": {
        "clips_kitty": {
          "type": "string",
          "pattern": "^\\s*(>=|<=|==|!=|>|<|~=)?\\s*\\d+(\\.\\d+){0,2}\\s*(,\\s*(>=|<=|==|!=|>|<|~=)?\\s*\\d+(\\.\\d+){0,2}\\s*)*$"
        },
        "plugin_api": {
          "enum": [
            1
          ]
        }
      }
    },
    "run": {
      "type": "object",
      "required": [
        "command"
      ],
      "properties": {
        "command": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "python_requirements": {
          "type": "string",
          "minLength": 1
        },
        "timeout_minutes": {
          "type": "number",
          "minimum": 1,
          "maximum": 1440
        }
      }
    },
    "execution": {
      "enum": [
        "local",
        "remote",
        "hybrid"
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "enum": [
          "video",
          "transcript"
        ]
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "enum": [
          "ranges"
        ]
      },
      "minItems": 1
    },
    "events": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,39}$"
      }
    },
    "games": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
      }
    },
    "settings": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,39}$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "string",
              "integer",
              "number",
              "boolean",
              "choice",
              "secret"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "default": {},
          "minimum": {
            "type": "number"
          },
          "maximum": {
            "type": "number"
          },
          "max_length": {
            "type": "integer",
            "minimum": 1
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        }
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "source",
          "id"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,39}$"
          },
          "source": {
            "enum": [
              "huggingface",
              "ollama",
              "url",
              "bundled"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "format": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "gated": {
            "type": "boolean"
          }
        }
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "enum": [
          "video.read",
          "transcript.read",
          "ffmpeg",
          "ollama",
          "gpu",
          "network",
          "filesystem.read",
          "filesystem.write",
          "project.read",
          "project.write"
        ]
      }
    },
    "network": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9.-]+(:[0-9]{1,5})?$"
      }
    },
    "sends": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "enum": [
              "video",
              "video_link",
              "audio",
              "frames",
              "transcript"
            ]
          },
          {
            "type": "object",
            "required": [
              "data",
              "to"
            ],
            "properties": {
              "data": {
                "enum": [
                  "video",
                  "video_link",
                  "audio",
                  "frames",
                  "transcript"
                ]
              },
              "to": {
                "type": "string",
                "minLength": 1
              },
              "when": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    },
    "requirements": {
      "type": "object",
      "properties": {
        "gpu": {
          "enum": [
            "none",
            "optional",
            "recommended",
            "required"
          ]
        },
        "vram_gb": {
          "type": "number",
          "minimum": 0
        },
        "ram_gb": {
          "type": "number",
          "minimum": 0
        },
        "disk_gb": {
          "type": "number",
          "minimum": 0
        },
        "os": {
          "type": "array",
          "items": {
            "enum": [
              "windows",
              "macos",
              "linux"
            ]
          }
        },
        "software": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "category": {
      "enum": [
        "gaming",
        "sports",
        "creators",
        "streaming",
        "podcasting",
        "captions",
        "detection",
        "analytics",
        "audio",
        "utilities"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
      },
      "maxItems": 10
    },
    "links": {
      "type": "object",
      "properties": {
        "docs": {
          "type": "string",
          "pattern": "^https://"
        },
        "funding": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      }
    },
    "service": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "name",
            "url",
            "required"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "pattern": "^https://"
            },
            "pricing": {
              "type": "string",
              "minLength": 1
            },
            "required": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "url"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      }
    },
    "based_on": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "name",
          "url",
          "license",
          "how"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "license": {
            "type": "string",
            "pattern": "^[A-Za-z0-9.+-]+( (AND|OR|WITH) [A-Za-z0-9.+-]+)*$"
          },
          "how": {
            "enum": [
              "runs",
              "includes-code",
              "port"
            ]
          }
        }
      }
    }
  }
}

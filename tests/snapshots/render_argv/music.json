          "-fps_mode",
          "cfr",
          "-movflags",
          "+faststart+negative_cts_offsets",
          "-shortest",
          "<TMP>/clips/clip_00010-00020.pre-card.mp4"
        ],
        "via": "Popen",
        "pipes": [
          "stdin"
        ],
        "stdin_bytes": 5890320
      },
      {
        "argv": [
          "ffmpeg",
          "-v",

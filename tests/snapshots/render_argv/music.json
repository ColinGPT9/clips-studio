        "via": "run"
      },
      {
        "argv": [
          "ffprobe",
          "-v",
          "error",
          "-ignore_editlist",
          "1",
          "-select_streams",
          "v:0",
          "-read_intervals",
          "%+#5",
          "-show_entries",
          "frame=pts_time",
          "-of",
          "csv=p=0",
          "<TMP>/clips/clip_00010-00020.mp4"
        ],
        "via": "run"
      }
    ],
    "calls": [
      {
        "tracker.compute_tracking": {
          "args": [
            "<TMP>/clips/clip_00010-00020.edited.mp4"

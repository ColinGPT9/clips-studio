          "-crf",
          "20",
          "-c:a",
          "aac",
          "-b:a",
          "128k",
          "-movflags",
          "+faststart",
          "<TMP>/clips/clip_00010-00020.source.mp4"
        ],
        "via": "run"
      },
      {
        "argv": [
          "ffmpeg",
          "-y",
          "-i",
          "<TMP>/clips/clip_00010-00020.source.mp4",
          "-stream_loop",
          "-1",
          "-i",
          "<TMP>/music.mp3",
          "-filter_complex",
          "[0:a]aresample=async=1[avoice];[1:a]atrim=0:10.000,asetpts=PTS-STARTPTS,volume=0.30[mus];[avoice]asplit=2[av1][av2];[mus][av2]sidechaincompress=threshold=0.02:ratio=12:attack=15:release=400[musd];[av1][musd]amix=inputs=2:duration=first:normalize=0[aout]",
          "-map",
          "0:v",
          "-map",
          "[aout]",
          "-c:v",
          "libx264",
          "-preset",
          "veryfast",
          "-crf",
          "20",
          "-c:a",
          "aac",
          "-b:a",
          "128k",
          "-fps_mode",
          "cfr",
          "-movflags",
          "+faststart",
          "<TMP>/clips/clip_00010-00020.edited.mp4"
        ],
        "via": "run"
      },
      {
        "argv": [
          "ffmpeg",
          "-y",
          "-f",
          "rawvideo",
          "-pix_fmt",
          "bgr24",
          "-s",
          "606x1080",
          "-r",
          "30.0",
          "-i",
          "pipe:0",
          "-i",
          "<TMP>/clips/clip_00010-00020.edited.mp4",
          "-map",
          "0:v:0",
          "-map",
          "1:a:0?",
          "-vf",

{
  "about": "The job's branding as a logo (clips.watermark, type image): one overlay pass over the finished render, put in its place before the end card is joined on.",
  "cpu": {
    "commands": [
      {
        "argv": [
          "ffmpeg",
          "-y",
          "-hwaccel",
          "auto",
          "-ss",
          "10.00",
          "-i",
          "<SRC>",
          "-t",
          "10.40",
          "-vsync",
          "cfr",
          "-af",
          "aresample=async=1",
          "-c:v",
          "libx264",
          "-preset",
          "veryfast",
          "-crf",
          "20",
          "-c:a",
          "aac",
          "-b:a",
          "128k",
          "-movflags",
          "+faststart",
          "<TMP>/clips/clip_00010-00020.source.mp4"
        ],
        "via": "run"
      },
      {
        "argv": [
          "ffmpeg",
          "-y",
          "-f",
          "rawvideo",
          "-pix_fmt",
          "bgr24",
          "-s",
          "606x1080",
          "-r",
          "30.0",
          "-i",
          "pipe:0",
          "-i",
          "<TMP>/clips/clip_00010-00020.source.mp4",
          "-map",
          "0:v:0",
          "-map",
          "1:a:0?",
          "-vf",
          "scale=1080:1920:flags=lanczos,setsar=1",
          "-c:v",
          "libx264",
          "-preset",
          "veryfast",
          "-crf",
          "20",
          "-pix_fmt",
          "yuv420p",
          "-c:a",
          "aac",
          "-b:a",
          "128k",
          "-af",
          "aresample=async=1,loudnorm=I=-14:TP=-1.5:LRA=11",
          "-fps_mode",
          "cfr",
          "-movflags",
          "+faststart+negative_cts_offsets",
          "-shortest",
          "<TMP>/clips/clip_00010-00020.pre-card.mp4"
        ],
        "via": "Popen",
        "pipes": [
          "stdin"
        ],
        "stdin_bytes": 5890320
      },
      {
        "argv": [
          "ffmpeg",
          "-v",
          "error",
          "-hwaccel",
          "auto",
          "-i",
          "<TMP>/clips/clip_00010-00020.source.mp4",
          "-vf",
          "select='not(mod(n\\,1))'",
          "-vsync",
          "0",
          "-pix_fmt",
          "bgr24",
          "-f",
          "rawvideo",
          "-"
        ],
        "via": "Popen",
        "pipes": [
          "stdout"
        ]
      },
      {
        "argv": [
          "ffmpeg",
          "-y",
          "-i",
          "<TMP>/clips/clip_00010-00020.pre-card.mp4",
          "-i",
          "<TMP>/data/branding/assets/logo.png",
          "-filter_complex",
          "[1:v]scale=194:-1:flags=lanczos,format=rgba,colorchannelmixer=aa=0.850[wm];[0:v][wm]overlay=W-w-43:43",
          "-map",
          "0:a?",
          "-c:v",
          "libx264",
          "-preset",
          "veryfast",
          "-crf",
          "20",
          "-c:a",
          "copy",
          "-movflags",
          "+faststart+negative_cts_offsets",
          "<TMP>/clips/clip_00010-00020.pre-card.wm.mp4"
        ],
        "via": "run"
      },
      {
        "argv": [
          "ffprobe",
          "-v",
          "error",
          "-show_streams",
          "-of",
          "json",
          "<TMP>/clips/clip_00010-00020.pre-card.mp4"
        ],
        "via": "run"
      },
      {
        "argv": [
          "ffmpeg",
          "-y",
          "-v",
          "error",
          "-f",
          "concat",
          "-safe",
          "0",
          "-i",
          "<TMP>/clips/clip_00010-00020.pre-card.cardlist.txt",
          "-copyts",
          "-c",
          "copy",
          "-movflags",
          "+faststart+negative_cts_offsets",
          "<TMP>/clips/clip_00010-00020.mp4"
        ],
        "via": "run",
        "listing": {
          "<TMP>/clips/clip_00010-00020.pre-card.cardlist.txt": [
            "file '<TMP>/clips/clip_00010-00020.pre-card.mp4'",
            "file '<TMP>/data/outro/outro2_1080x1920_30_yuv420p_48000_2.mp4'"
          ]
        }
      },
      {
        "argv": [
          "ffprobe",
          "-v",
          "error",
          "-select_streams",
          "v:0",
          "-read_intervals",
          "%+#5",
          "-show_entries",
          "frame=pts_time",
          "-of",
          "csv=p=0",
          "<TMP>/clips/clip_00010-00020.mp4"
        ],
        "via": "run"
      },
      {
        "argv": [
          "ffprobe",
          "-v",
          "error",
          "-ignore_editlist",
          "1",
          "-select_streams",
          "v:0",
          "-read_intervals",
          "%+#5",
          "-show_entries",
          "frame=pts_time",
          "-of",
          "csv=p=0",
          "<TMP>/clips/clip_00010-00020.mp4"
        ],
        "via": "run"
      }
    ],
    "calls": [
      {
        "tracker.compute_tracking": {
          "args": [
            "<TMP>/clips/clip_00010-00020.source.mp4"
          ],
          "model_name": "yolov8n-pose.pt",
          "sample_fps": 8,
          "force_fit_blur": false,
          "shot_aware": true,
          "no_subject": "center"
        }
      }
    ],
    "returned": "<TMP>/clips/clip_00010-00020.mp4",
    "render_opts": {
      "watermark": {
        "type": "image",
        "image_asset": "logo.png",
        "position": "top_right",
        "scale": 0.18,
        "opacity": 0.85,
        "padding": 0.04
      },
      "job_captions": false
    },
    "files": [
      "clips/clip_00010-00020.mp4",
      "data/branding/assets/logo.png",
      "data/outro/outro2_1080x1920_30_yuv420p_48000_2.mp4",
      "source.mp4"
    ]
  },

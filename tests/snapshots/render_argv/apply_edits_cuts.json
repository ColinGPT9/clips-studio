{
  "about": "video_editor/export.py: two kept sections, trimmed and joined.",
  "cpu": {
    "commands": [
      {
        "argv": [
          "ffmpeg",
          "-y",
          "-i",
          "<TMP>/clip.source.mp4",
          "-filter_complex",
          "[0:v]trim=start=0.000:end=3.200,setpts=PTS-STARTPTS[v0];[0:a]atrim=start=0.000:end=3.200,asetpts=PTS-STARTPTS[a0];[0:v]trim=start=4.600:end=10.000,setpts=PTS-STARTPTS[v1];[0:a]atrim=start=4.600:end=10.000,asetpts=PTS-STARTPTS[a1];[v0][a0][v1][a1]concat=n=2:v=1:a=1[vcut][acut];[acut]aresample=async=1[aout]",
          "-map",
          "[vcut]",
          "-map",
          "[aout]",
          "-c:v",
          "libx264",
          "-preset",
          "veryfast",
          "-crf",
          "20",
          "-c:a",
          "aac",
          "-b:a",
          "128k",
          "-fps_mode",
          "cfr",
          "-movflags",
          "+faststart",
          "<TMP>/clip.edited.mp4"
        ],
        "via": "run"
      }
    ],
    "files": [
      "clip.edited.mp4",
      "clip.source.mp4"
    ]
  },
  "nvenc": {
    "commands": [
      {
        "argv": [
          "ffmpeg",
          "-y",
          "-i",
          "<TMP>/clip.source.mp4",
          "-filter_complex",
          "[0:v]trim=start=0.000:end=3.200,setpts=PTS-STARTPTS[v0];[0:a]atrim=start=0.000:end=3.200,asetpts=PTS-STARTPTS[a0];[0:v]trim=start=4.600:end=10.000,setpts=PTS-STARTPTS[v1];[0:a]atrim=start=4.600:end=10.000,asetpts=PTS-STARTPTS[a1];[v0][a0][v1][a1]concat=n=2:v=1:a=1[vcut][acut];[acut]aresample=async=1[aout]",
          "-map",
          "[vcut]",
          "-map",
          "[aout]",
          "-c:v",
          "h264_nvenc",
          "-preset",
          "p5",
          "-rc",
          "vbr",
          "-cq",
          "23",
          "-b:v",
          "0",
          "-c:a",
          "aac",
          "-b:a",
          "128k",
          "-fps_mode",
          "cfr",
          "-movflags",
          "+faststart",
          "<TMP>/clip.edited.mp4"
        ],
        "via": "run"
      }
    ],
    "files": [
      "clip.edited.mp4",
      "clip.source.mp4"
    ]
  }
}

{
  "about": "video_editor/export.py: background music, ducked and not.",
  "cpu": {
    "commands": [
      {
        "step": "ducked under the voice, with cuts",
        "argv": [
          "ffmpeg",
          "-y",
          "-i",
          "<TMP>/clip.source.mp4",
          "-stream_loop",
          "-1",
          "-i",
          "<TMP>/music.mp3",
          "-filter_complex",
          "[0:v]trim=start=0.000:end=4.000,setpts=PTS-STARTPTS[v0];[0:a]atrim=start=0.000:end=4.000,asetpts=PTS-STARTPTS[a0];[0:v]trim=start=5.000:end=10.000,setpts=PTS-STARTPTS[v1];[0:a]atrim=start=5.000:end=10.000,asetpts=PTS-STARTPTS[a1];[v0][a0][v1][a1]concat=n=2:v=1:a=1[vcut][acut];[acut]aresample=async=1[avoice];[1:a]atrim=0:9.000,asetpts=PTS-STARTPTS,volume=0.30[mus];[avoice]asplit=2[av1][av2];[mus][av2]sidechaincompress=threshold=0.02:ratio=12:attack=15:release=400[musd];[av1][musd]amix=inputs=2:duration=first:normalize=0[aout]",
          "-map",
          "[vcut]",
          "-map",
          "[aout]",
          "-c:v",
          "libx264",
          "-preset",
          "veryfast",
          "-crf",
          "20",
          "-c:a",
          "aac",
          "-b:a",
          "128k",
          "-fps_mode",
          "cfr",
          "-movflags",
          "+faststart",
          "<TMP>/clip.edited.mp4"
        ],
        "via": "run"
      },
      {
        "step": "not ducked, fading out, written as the clip",
        "argv": [
          "ffmpeg",
          "-y",
          "-i",
          "<TMP>/clip.source.mp4",
          "-stream_loop",
          "-1",
          "-i",
          "<TMP>/music.mp3",
          "-filter_complex",
          "[0:a]loudnorm=I=-14:TP=-1.5:LRA=11,afade=t=out:st=9.000:d=1.00,aresample=async=1[avoice];[1:a]atrim=0:10.000,asetpts=PTS-STARTPTS,volume=0.50[mus];[avoice][mus]amix=inputs=2:duration=first:normalize=0[aout]",
          "-map",
          "0:v",
          "-map",
          "[aout]",
          "-c:v",
          "libx264",
          "-preset",
          "veryfast",
          "-crf",
          "20",
          "-c:a",
          "aac",
          "-b:a",
          "128k",
          "-fps_mode",
          "cfr",
          "-movflags",
          "+faststart+negative_cts_offsets",
          "<TMP>/clip.mp4"
        ],
        "via": "run"
      }
    ],
    "files": [
      "clip.edited.mp4",
      "clip.mp4",
      "clip.source.mp4",
      "music.mp3"
    ]
  },

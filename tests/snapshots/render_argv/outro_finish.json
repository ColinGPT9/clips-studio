{
  "about": "video/outro.py finish(): the end card joined onto a clip, the shipped card copied into the cache.",
  "cpu": {
    "commands": [
      {
        "argv": [
          "ffprobe",
          "-v",
          "error",
          "-show_streams",
          "-of",
          "json",
          "<TMP>/clips/clip_00010-00020.pre-card.mp4"
        ],
        "via": "run"
      },
      {
        "argv": [
          "ffmpeg",
          "-y",
          "-v",
          "error",
          "-f",
          "concat",
          "-safe",
          "0",
          "-i",
          "<TMP>/clips/clip_00010-00020.pre-card.cardlist.txt",
          "-copyts",
          "-c",
          "copy",
          "-movflags",
          "+faststart+negative_cts_offsets",
          "<TMP>/clips/clip_00010-00020.mp4"
        ],
        "via": "run",
        "listing": {
          "<TMP>/clips/clip_00010-00020.pre-card.cardlist.txt": [
            "file '<TMP>/clips/clip_00010-00020.pre-card.mp4'",
            "file '<TMP>/data/outro/outro2_1080x1920_30_yuv420p_48000_2.mp4'"
          ]
        }
      },
      {
        "argv": [
          "ffprobe",
          "-v",
          "error",
          "-select_streams",
          "v:0",
          "-read_intervals",
          "%+#5",
          "-show_entries",
          "frame=pts_time",
          "-of",
          "csv=p=0",
          "<TMP>/clips/clip_00010-00020.mp4"
        ],
        "via": "run"
      },
      {
        "argv": [
          "ffprobe",
          "-v",
          "error",
          "-ignore_editlist",
          "1",
          "-select_streams",
          "v:0",
          "-read_intervals",
          "%+#5",
          "-show_entries",
          "frame=pts_time",
          "-of",
          "csv=p=0",
          "<TMP>/clips/clip_00010-00020.mp4"
        ],
        "via": "run"
      }
    ],
    "returned": true,
    "files": [
      "clips/clip_00010-00020.mp4",
      "data/outro/outro2_1080x1920_30_yuv420p_48000_2.mp4"
    ]
  },

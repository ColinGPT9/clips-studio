{
  "about": "video/encoding.py concat(): stream-copy joins through a listing.",
  "cpu": {
    "commands": [
      {
        "step": "a clip and its card, from a folder whose name has a quote",
        "argv": [
          "ffmpeg",
          "-y",
          "-v",
          "error",
          "-f",
          "concat",
          "-safe",
          "0",
          "-i",
          "<TMP>/I'll be fine [abc123]/.clip.outro.txt",
          "-copyts",
          "-c",
          "copy",
          "-movflags",
          "+faststart+negative_cts_offsets",
          "<TMP>/I'll be fine [abc123]/.clip.joined.mp4"
        ],
        "via": "run",
        "listing": {
          "<TMP>/I'll be fine [abc123]/.clip.outro.txt": [
            "file '<TMP>/I'\\''ll be fine [abc123]/clip.mp4'",

{
  "about": "video/cutter.py: the staging cut a vertical render crops from. No loudness pass, plain +faststart.",
  "cpu": {
    "commands": [
      {
        "argv": [
          "ffmpeg",
          "-y",
          "-hwaccel",
          "auto",
          "-ss",
          "10.00",
          "-i",
          "<SRC>",
          "-t",
          "10.40",
          "-vsync",
          "cfr",
          "-af",
          "aresample=async=1",
          "-c:v",
          "libx264",
          "-preset",
          "veryfast",
          "-crf",
          "20",
          "-c:a",
          "aac",
          "-b:a",
          "128k",
          "-movflags",
          "+faststart",
          "<OUT>"
        ],
        "via": "run"
      }
    ],
    "files": [
      "clip.source.mp4",
      "source.mp4"
    ]
  },
  "nvenc": {
    "commands": [
      {
        "argv": [
          "ffmpeg",
          "-y",
          "-hwaccel",
          "auto",
          "-ss",
          "10.00",
          "-i",
          "<SRC>",
          "-t",
          "10.40",
          "-vsync",
          "cfr",
          "-af",
          "aresample=async=1",
          "-c:v",
          "h264_nvenc",
          "-preset",
          "p5",
          "-rc",
          "vbr",
          "-cq",
          "23",
          "-b:v",
          "0",
          "-c:a",
          "aac",
          "-b:a",
          "128k",
          "-movflags",
          "+faststart",
          "<OUT>"
        ],
        "via": "run"
      }
    ],
    "files": [
      "clip.source.mp4",
      "source.mp4"
    ]
  }
}

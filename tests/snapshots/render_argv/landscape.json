{
  "about": "A Longform clip (render_opts.profile, which only longform/ sets): 16:9 at 1920x1080 in one encode with the fit and pad, captions on and scaled to the landscape canvas, the 1920x1080 end card.",
  "cpu": {
    "commands": [
      {
        "argv": [
          "ffmpeg",
          "-y",
          "-hwaccel",
          "auto",
          "-ss",
          "10.00",
          "-i",
          "<SRC>",
          "-t",
          "10.40",
          "-vsync",
          "cfr",
          "-af",
          "aresample=async=1,loudnorm=I=-14:TP=-1.5:LRA=11",
          "-c:v",
          "libx264",
          "-preset",
          "veryfast",
          "-crf",
          "20",
          "-c:a",
          "aac",
          "-b:a",
          "128k",
          "-movflags",
          "+faststart+negative_cts_offsets",
          "-vf",
          "scale=1920:1080:force_original_aspect_ratio=decrease:flags=lanczos,pad=1920:1080:(ow-iw)/2:(oh-ih)/2,setsar=1,subtitles=clip_00010-00020.ass",
          "<TMP>/clips/clip_00010-00020.pre-card.mp4"
        ],
        "via": "run",
        "cwd": "<TMP>/clips",
        "ass": {
          "clip_00010-00020.ass": [
            "[Script Info]",
            "ScriptType: v4.00+",
            "PlayResX: 1920",
            "PlayResY: 1080",
            "WrapStyle: 0",
            "",
            "[V4+ Styles]",
            "Format: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, OutlineColour, BackColour, Bold, Italic, Underline, StrikeOut, ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, Alignment, MarginL, MarginR, MarginV, Encoding",
            "Style: Default,Arial,47,&H00FFFFFF,&H00FFFFFF,&H00000000,&H7F000000,-1,0,0,0,100,100,0,0,1,7,2,2,60,60,248,1",
            "",
            "[Events]",
            "Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text",
            "Dialogue: 0,0:00:00.02,0:00:00.55,Default,,0,0,0,,SO THIS IS",
            "Dialogue: 0,0:00:00.58,0:00:01.30,Default,,0,0,0,,THE PART WHERE",
            "Dialogue: 0,0:00:01.33,0:00:02.05,Default,,0,0,0,,IT ALL GOES",
            "Dialogue: 0,0:00:02.10,0:00:03.58,Default,,0,0,0,,WRONG WATCH THE",
            "Dialogue: 0,0:00:03.62,0:00:05.05,Default,,0,0,0,,LEFT SIDE, RIGHT",
            "Dialogue: 0,0:00:05.10,0:00:07.02,Default,,0,0,0,,THERE. NO WAY",
            "Dialogue: 0,0:00:07.10,0:00:08.35,Default,,0,0,0,,THAT JUST HAPPENED!",
            "Dialogue: 0,0:00:08.92,0:00:09.70,Default,,0,0,0,,CHAT DID YOU",
            "Dialogue: 0,0:00:09.75,0:00:09.98,Default,,0,0,0,,SEE"
          ]
        }
      },
      {
        "argv": [
          "ffprobe",
          "-v",
          "error",
          "-show_streams",
          "-of",
          "json",
          "<TMP>/clips/clip_00010-00020.pre-card.mp4"
        ],
        "via": "run"
      },
      {
        "argv": [
          "ffmpeg",
          "-y",
          "-v",
          "error",
          "-f",
          "concat",
          "-safe",
          "0",
          "-i",
          "<TMP>/clips/clip_00010-00020.pre-card.cardlist.txt",
          "-copyts",
          "-c",
          "copy",
          "-movflags",
          "+faststart+negative_cts_offsets",
          "<TMP>/clips/clip_00010-00020.mp4"
        ],
        "via": "run",
        "listing": {
          "<TMP>/clips/clip_00010-00020.pre-card.cardlist.txt": [
            "file '<TMP>/clips/clip_00010-00020.pre-card.mp4'",
            "file '<TMP>/data/outro/outro2_1920x1080_30_yuv420p_48000_2.mp4'"
          ]
        }
      },
      {
        "argv": [
          "ffprobe",
          "-v",
          "error",
          "-select_streams",
          "v:0",
          "-read_intervals",
          "%+#5",
          "-show_entries",
          "frame=pts_time",
          "-of",
          "csv=p=0",
          "<TMP>/clips/clip_00010-00020.mp4"
        ],
        "via": "run"
      },
      {
        "argv": [
          "ffprobe",
          "-v",
          "error",
          "-ignore_editlist",
          "1",
          "-select_streams",
          "v:0",
          "-read_intervals",
          "%+#5",
          "-show_entries",
          "frame=pts_time",
          "-of",
          "csv=p=0",
          "<TMP>/clips/clip_00010-00020.mp4"
        ],
        "via": "run"
      }
    ],
    "returned": "<TMP>/clips/clip_00010-00020.mp4",
    "render_opts": {
      "profile": "short_clips"
    },
    "files": [
      "clips/clip_00010-00020.mp4",
      "data/outro/outro2_1920x1080_30_yuv420p_48000_2.mp4",
      "source.mp4"
    ]
  },

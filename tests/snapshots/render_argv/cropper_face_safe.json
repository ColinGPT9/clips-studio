            "Style: Default,Arial,84,&H00FFFFFF,&H00FFFFFF,&H00000000,&H7F000000,-1,0,0,0,100,100,0,0,1,7,2,2,60,60,440,1",
            "",
            "[Events]",
            "Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text",
            "Dialogue: 0,0:00:00.02,0:00:00.55,Default,,0,0,0,,SO THIS IS",
            "Dialogue: 0,0:00:00.58,0:00:01.30,Default,,0,0,0,,THE PART WHERE",
            "Dialogue: 0,0:00:01.33,0:00:02.05,Default,,0,0,0,,IT ALL GOES",
            "Dialogue: 0,0:00:02.10,0:00:03.58,Default,,0,0,0,,WRONG WATCH THE",
            "Dialogue: 0,0:00:03.62,0:00:05.05,Default,,0,0,0,,LEFT SIDE, RIGHT",
            "Dialogue: 0,0:00:05.10,0:00:07.02,Default,,0,0,0,,THERE. NO WAY",
            "Dialogue: 0,0:00:07.10,0:00:08.35,Default,,0,0,0,,THAT JUST HAPPENED!",
            "Dialogue: 0,0:00:08.92,0:00:09.70,Default,,0,0,0,,CHAT DID YOU",
            "Dialogue: 0,0:00:09.75,0:00:09.98,Default,,0,0,0,,SEE"
          ]
        },
        "stdin_bytes": 8398080
      },
      {
        "argv": [
          "ffmpeg",
          "-v",
          "error",
          "-hwaccel",
          "auto",
          "-i",
          "<TMP>/clip.source.mp4",
          "-vf",
          "select='not(mod(n\\,1))'",
          "-vsync",
          "0",
          "-pix_fmt",
          "bgr24",
          "-f",
          "rawvideo",
          "-"
        ],
        "via": "Popen",
        "pipes": [
          "stdout"
        ]
      }
    ],
    "files": [
      "clip.ass",
      "clip.mp4",
      "clip.source.mp4"
    ]
  },

          "-map",
          "[v]",
          "-map",
          "1:a:0?",
          "-c:v",
          "libx264",
          "-preset",
          "veryfast",
          "-crf",
          "20",
          "-pix_fmt",
          "yuv420p",
          "-c:a",
          "aac",
          "-b:a",
          "128k",
          "-af",
          "aresample=async=1,loudnorm=I=-14:TP=-1.5:LRA=11",
          "-fps_mode",
          "cfr",
          "-movflags",
          "+faststart+negative_cts_offsets",
          "-shortest",
          "<OUT>"
        ],
        "via": "Popen",
        "pipes": [
          "stdin"
        ],
        "cwd": "<TMP>",
        "ass": {
          "clip.ass": [
            "[Script Info]",
            "ScriptType: v4.00+",
            "PlayResX: 1080",
            "PlayResY: 1920",
            "WrapStyle: 0",
            "",

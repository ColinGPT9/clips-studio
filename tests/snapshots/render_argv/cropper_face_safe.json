{
  "about": "A face in the top quarter: the wider 4:5 crop under the platforms' top bar, on a blurred wash.",
  "cpu": {
    "commands": [
      {
        "argv": [
          "ffmpeg",
          "-y",
          "-f",
          "rawvideo",
          "-pix_fmt",
          "bgr24",
          "-s",
          "864x1080",
          "-r",
          "30.0",
          "-i",
          "pipe:0",
          "-i",
          "<TMP>/clip.source.mp4",
          "-filter_complex",

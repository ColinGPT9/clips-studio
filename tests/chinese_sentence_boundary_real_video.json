  "segments": [
    {
      "start": 20.9,
      "end": 23.5,
      "text": "对这个问题做出明确解答"
    },
    {
      "start": 24.14,
      "end": 26.26,
      "text": "三星堆初途非常奇特"
    },
    {
      "start": 26.26,
      "end": 28.48,
      "text": "但是也不是那么的奇怪"
    },
    {
      "start": 28.48,
      "end": 30.66,
      "text": "它更不可能是外星文明"
    },
    {
      "start": 30.66,
      "end": 32.62,
      "text": "有人之所以这么说"
    },
    {
      "start": 32.62,
      "end": 34.78,
      "text": "可能是有一个意识的前提"
    },
    {
      "start": 34.78,
      "end": 36.96,
      "text": "那就是认为"
    },
    {
      "start": 36.96,
      "end": 39.56,
      "text": "古代的文明都是已知的"
    },
    {
      "start": 39.56,
      "end": 40.52,
      "text": "是单一的"
    },
    {
      "start": 40.52,
      "end": 42.84,
      "text": "但事实上的这个古代文明"
    },
    {
      "start": 42.84,
      "end": 45.08,
      "text": "它是丰富多彩的"
    },
    {
      "start": 45.08,
      "end": 46.78,
      "text": "而且有很多文明"
    },
    {
      "start": 46.78,
      "end": 48.62,
      "text": "还处于这个探索之中"
    },
    {
      "start": 48.62,
      "end": 50.5,
      "text": "所以我们这个探索的过程"
    },
    {
      "start": 50.5,
      "end": 52.16,
      "text": "也是一个长期的"
    },
    {
      "start": 52.16,
      "end": 53.62,
      "text": "所以我们不能因为"
    },
    {
      "start": 53.62,
      "end": 57.46,
      "text": "一种文明它是陌生的"
    },
    {
      "start": 57.46,
      "end": 58.56,
      "text": "或者是未知的"
    },
    {
      "start": 58.56,
      "end": 61.42,
      "text": "我们就认为它是外星文明"
    },
    {
      "start": 61.42,
      "end": 62.92,
      "text": "是尽松介绍"
    },
    {
      "start": 62.92,
      "end": 66.84,
      "text": "三星对文明有其自身产生发展的普及"
    },
    {
      "start": 66.84,
      "end": 69.96,
      "text": "并且与其他文化还存在着交流"
    },
    {
      "start": 69.96,
      "end": 72.7,
      "text": "具体来说它是从成都平安的"
    },
    {
      "start": 72.7,
      "end": 77.38,
      "text": "新时期时代晚期的保顿文化发展而来的"
    },
    {
      "start": 77.86,
      "end": 82.06,
      "text": "这期间吸收了其他区域的文化的一些因素"
    },
    {
      "start": 82.7,
      "end": 84.78,
      "text": "往后发展为金沙文化"
    }
  ]

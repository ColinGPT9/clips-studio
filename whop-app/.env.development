# PLACEHOLDERS ONLY. This file is committed to a public repo.
# Put the real values in .env.local, which is git-ignored.
#
# Only two values are needed. There is no webhook secret: this app has no
# webhook route, because Clips Studio is free and there are no payments to
# be notified about.

# Public. Inlined into the browser bundle, so it must be set before the
# production build, not after.
NEXT_PUBLIC_WHOP_APP_ID="app_placeholder_replace_me"

# SECRET. Acts as your app. Never commit a real one.
WHOP_API_KEY="placeholder_replace_me"

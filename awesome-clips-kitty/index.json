   "description": "An example pipeline. It finds stretches that are clearly louder than the rest of the video and starts each clip on the nearest scene cut before it, using FFmpeg only. It knows nothing about what is happening on screen: loud is not always interesting, and quiet highlights are missed.\n",
   "events": [
    "loud"
   ],
   "execution": "local",
   "id": "clips-kitty-examples/scene-cut-highlights",
   "inputs": [
    "video"
   ],
   "kind": "pipeline",
   "latest": "1.0.0",
   "license": "MIT",
   "metrics": {},
   "name": "Loud moments, cut on scene changes (example)",
   "network": [],
   "outputs": [
    "ranges"
   ],
   "path": "examples/pipelines/scene-cut-highlights",
   "permissions": [
    "video.read",
    "ffmpeg"
   ],
   "publisher": "clips-kitty-examples",
   "relationship": "built-for",
   "repository": "https://github.com/ColinGPT9/clips-studio",
